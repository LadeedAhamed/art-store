# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION FOR ELENA MOORE ART STORE
# ==============================================================================

# 1. DATABASE (Production Neon Serverless PostgreSQL - Recommended $0/mo Free Tier)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@ep-[PROJECT-ID]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://[USER]:[PASSWORD]@ep-[PROJECT-ID].[REGION].aws.neon.tech/neondb?sslmode=require"

# 2. APPLICATION URL & AUTH
NEXT_PUBLIC_SITE_URL="https://elenamoore.art"
NEXTAUTH_URL="https://elenamoore.art"
NEXTAUTH_SECRET="generate_a_random_32_character_secret_with_openssl"

# 3. SUPER ADMIN CREDENTIALS (for /admin)
ADMIN_PASSWORD="YourStrongStudioMasterPassword2026!"
ADMIN_SECRET_KEY="your-random-hmac-salt-string"

# 4. STRIPE PAYMENT GATEWAY (Live credentials from dashboard.stripe.com)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 5. HIGH-RES ARTWORK MEDIA STORAGE (Cloudinary CDN)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# 6. SHIPROCKET AUTOMATED LOGISTICS (shiprocket.in)
SHIPROCKET_EMAIL="your-shiprocket-email@domain.com"
SHIPROCKET_PASSWORD="your-shiprocket-password"
SHIPROCKET_PICKUP_LOCATION="Primary"

# 7. TRANSACTIONAL EMAILS (SMTP / Gmail / Resend / AWS SES)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="orders@elenamoore.art"
SMTP_PASS="your-app-password"
SMTP_FROM="orders@elenamoore.art"
CONTACT_EMAIL="hello@elenamoore.art"
